---
import { services } from '../content/services';
import ServiceIcon from './ServiceIcon.astro';
---

<section
  class="section services-section"
  id="servicios"
  aria-labelledby="servicios-titulo"
>
  <div class="wrap">
    <div class="section-head">
      <span class="section-index" aria-hidden="true">
        01 /
      </span>
      <h2 id="servicios-titulo">Nuestros servicios</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <div class="services">
      {services.map((service, index) => (
        <article
          class:list={[
            'service',
            { 'service-complementary': 'note' in service },
          ]}
        >
          <div class="service-top" aria-hidden="true">
            <ServiceIcon name={service.icon} />
            <span class="number">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            {'note' in service && <p class="service-note">{service.note}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
