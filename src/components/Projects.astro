---
import PhotoCarousel from './PhotoCarousel.astro';
import { workPhotos } from '../content/work';
---

<section class="section projects-section" aria-labelledby="trabajos-titulo">
  <div class="wrap projects-layout">
    <div class="section-head">
      <span class="section-index" aria-hidden="true">
        02 /
      </span>
      <h2 id="trabajos-titulo">Nuestro trabajo en terreno.</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <PhotoCarousel
      photos={workPhotos}
      id="trabajo-fotos"
      label="Galería de trabajos"
      variant="work"
    />
  </div>
</section>
