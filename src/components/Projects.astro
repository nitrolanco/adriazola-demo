---
import PhotoCarousel from './PhotoCarousel.astro';
import { workPhotos } from '../content/work';
---

<section class="section" aria-labelledby="trabajos-titulo">
  <div class="section-head">
    <h2 id="trabajos-titulo">Nuestro trabajo en terreno.</h2>
  </div>
  <PhotoCarousel
    photos={workPhotos}
    id="trabajo-fotos"
    label="Galería de trabajos"
    variant="work"
  />
</section>
