---
import { contact } from '../config/site';
import { contactFormName } from '../lib/email';
import { buildWhatsAppUrl } from '../lib/contact';

const directWhatsApp = buildWhatsAppUrl(contact.whatsappNumber, {
  message:
    'Hola, quisiera consultar por un servicio de Adriazola Electricidad.',
  email: '',
  phone: '',
});
---

<section class="section" id="contacto" aria-labelledby="contacto-titulo">
  <div class="contact">
    <div class="contact-intro">
      <p class="eyebrow">Conversemos</p>
      <h2 id="contacto-titulo">
        Tu próximo proyecto empieza con una conversación.
      </h2>
      <p>Cuéntanos qué necesitas. Te ayudamos a dar el siguiente paso.</p>
      <a
        class="cta contact-direct"
        href={directWhatsApp}
        target="_blank"
        rel="noopener noreferrer"
      >
        Hablar por WhatsApp <span aria-hidden="true">↗</span>
      </a>
      <p class="help">Directo al chat, sin formularios.</p>
      <p class="phone-contact">
        ¿Prefieres llamar?
        <br />
        <a href={`tel:${contact.phoneNumber}`}>
          Llamar al {contact.phoneLabel}
        </a>
        <span class="help">Solo llamadas.</span>
      </p>
      <p class="email-contact">
        Correo electrónico
        <br />
        <a href={`mailto:${contact.emailRecipient}`}>
          {contact.emailRecipient}
        </a>
      </p>
    </div>
    <form
      id="contact-form"
      aria-labelledby="consulta-titulo"
      name={contactFormName}
      method="POST"
      action="/"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-email-enabled={String(contact.netlifyFormsEnabled)}
      novalidate
    >
      <input type="hidden" name="form-name" value={contactFormName} />
      <div hidden>
        <label for="bot-field">Deja este campo vacío</label>
        <input
          id="bot-field"
          name="bot-field"
          tabindex="-1"
          autocomplete="off"
        />
      </div>
      <h3 id="consulta-titulo">Prepara tu consulta</h3>
      <p class="form-intro">Por WhatsApp o correo, tú eliges.</p>
      <label for="consulta">Tu consulta</label>
      <textarea
        id="consulta"
        name="message"
        aria-describedby="consulta-help message-error"
        placeholder="Necesito ayuda con…"
        required
      ></textarea>
      <p class="help" id="consulta-help">
        Cuéntanos qué necesitas y en qué localidad.
      </p>
      <p class="field-error" id="message-error" hidden></p>
      <button
        type="submit"
        class="cta"
        name="channel"
        value="whatsapp"
        disabled
      >
        Continuar en WhatsApp <span aria-hidden="true">↗</span>
      </button>
      <details>
        <summary>Prefiero enviar por correo</summary>
        {!contact.netlifyFormsEnabled && (
          <p class="help">
            Correo no disponible. Contáctanos por WhatsApp o teléfono.
          </p>
        )}
        <p class="help" id="contacto-help">
          Déjanos un email o teléfono para responderte.
        </p>
        <label for="correo">Email (opcional si indicas teléfono)</label>
        <input
          id="correo"
          name="email"
          type="email"
          autocomplete="email"
          aria-describedby="contacto-help email-error"
          placeholder="tu@email.cl"
        />
        <p class="field-error" id="email-error" hidden></p>
        <label for="telefono">Teléfono (opcional si indicas email)</label>
        <input
          id="telefono"
          name="phone"
          type="tel"
          autocomplete="tel"
          aria-describedby="contacto-help"
          placeholder="+56 9 …"
        />
        <p class="help">
          Usaremos tus datos para responder tu consulta. El envío se procesa
          mediante Netlify Forms y lo recibe Adriazola Electricidad, con copia a
          su colaborador de soporte. No incluyas datos sensibles.
        </p>
        <button type="submit" class="cta" name="channel" value="email" disabled>
          Enviar consulta por correo
        </button>
      </details>
      <p class="notice" id="contact-notice" role="status" aria-live="polite">
        No se envía nada mientras escribes.
      </p>
      <a
        id="whatsapp-fallback"
        target="_blank"
        rel="noopener noreferrer"
        hidden
      >
        Si WhatsApp no se abrió, abre tu consulta aquí
      </a>
      <noscript>
        <p>
          Activa JavaScript para preparar tu consulta, o usa el enlace directo a
          WhatsApp al inicio de la página.
        </p>
      </noscript>
    </form>
  </div>
</section>

<script>
  import { buildWhatsAppUrl, validateContact } from '../lib/contact';
  import { contact } from '../config/site';
  import { sendContactEmail } from '../lib/email';

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    const message = form.querySelector<HTMLTextAreaElement>('#consulta')!;
    const email = form.querySelector<HTMLInputElement>('#correo')!;
    const phone = form.querySelector<HTMLInputElement>('#telefono')!;
    const notice = form.querySelector<HTMLElement>('#contact-notice')!;
    const fallback =
      form.querySelector<HTMLAnchorElement>('#whatsapp-fallback')!;
    const fields = { message, email, phone };
    let sending = false;
    const submitButtons = form.querySelectorAll<HTMLButtonElement>(
      'button[type="submit"]',
    );

    const clearErrors = () => {
      for (const field of Object.values(fields))
        field.removeAttribute('aria-invalid');
      for (const error of form.querySelectorAll<HTMLElement>('.field-error')) {
        error.hidden = true;
        error.textContent = '';
      }
    };

    form.addEventListener('input', () => {
      if (sending) return;
      clearErrors();
      fallback.hidden = true;
      fallback.removeAttribute('href');
      notice.textContent =
        'WhatsApp abrirá tu consulta para que la revises y la envíes.';
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;
      clearErrors();
      fallback.hidden = true;
      fallback.removeAttribute('href');
      const submitter = event.submitter;
      const channel =
        submitter instanceof HTMLButtonElement && submitter.value === 'email'
          ? 'email'
          : 'whatsapp';
      const error = validateContact(
        { message: message.value, email: email.value, phone: phone.value },
        channel,
      );
      if (error) {
        const field = fields[error.field];
        const errorText = form.querySelector<HTMLElement>(
          `#${error.field}-error`,
        );
        field.setAttribute('aria-invalid', 'true');
        if (errorText) {
          errorText.hidden = false;
          errorText.textContent = error.message;
        }
        notice.textContent = error.message;
        field.focus();
        return;
      }
      if (channel === 'whatsapp') {
        const url = buildWhatsAppUrl(contact.whatsappNumber, {
          message: message.value,
          email: email.value,
          phone: phone.value,
        });
        fallback.href = url;
        fallback.hidden = false;
        window.open(url, '_blank', 'noopener,noreferrer');
        notice.textContent =
          'Se solicitó abrir WhatsApp. Revisa tu consulta y pulsa enviar allí; todavía no se ha enviado el mensaje.';
        return;
      }
      sending = true;
      form.setAttribute('aria-busy', 'true');
      for (const button of submitButtons) button.disabled = true;
      for (const field of Object.values(fields)) field.readOnly = true;
      notice.textContent = 'Enviando tu consulta…';
      try {
        await sendContactEmail(
          form.dataset.emailEnabled === 'true',
          {
            message: message.value,
            email: email.value,
            phone: phone.value,
          },
          form.querySelector<HTMLInputElement>('#bot-field')!.value,
        );
        notice.textContent =
          'Consulta recibida por el servicio de correo. Conservamos el texto aquí para tu referencia.';
      } catch (error) {
        notice.textContent =
          error instanceof Error
            ? error.message
            : 'No pudimos confirmar el envío. Tu consulta sigue aquí.';
      } finally {
        sending = false;
        form.removeAttribute('aria-busy');
        for (const button of submitButtons) button.disabled = false;
        for (const field of Object.values(fields)) field.readOnly = false;
      }
    });

    for (const button of form.querySelectorAll<HTMLButtonElement>(
      'button[type="submit"]',
    ))
      button.disabled = false;
  }
</script>
