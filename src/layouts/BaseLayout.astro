---
import '../styles/global.css';
import { site } from '../config/site';
import { isOfficialIndexable } from '../lib/seo';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const indexable = isOfficialIndexable(
  import.meta.env.PUBLIC_SITE_INDEXABLE,
  Astro.site?.href,
  import.meta.env.BASE_URL,
);
const shareImage = new URL('images/work/solar2.jpeg', site.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable ? 'index, follow' : 'noindex, nofollow'}
    />
    {indexable && <link rel="canonical" href={site.url} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Adriazola Electricidad" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={site.url} />}
    {indexable && <meta property="og:image" content={shareImage} />}
    {indexable && (
      <meta
        property="og:image:alt"
        content="Instalación solar en una vivienda frente a la cordillera"
      />
    )}
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}brand/adriazola-a.svg`}
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
